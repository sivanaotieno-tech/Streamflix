# Local PyMovieDb metadata service; see pymoviedb-service/README.md.
PYMOVIEDB_API_URL=http://127.0.0.1:8001

# Streamivio subscriptions. Hyperswitch is sandbox-only; production payments are not enabled.
PAYMENT_PROVIDER=hyperswitch
HYPERSWITCH_ENV=sandbox
HYPERSWITCH_API_KEY=
HYPERSWITCH_WEBHOOK_SECRET=
# Optional alternate provider: IntaSend (configure only if you deliberately select it).
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
# Durable account and subscription records.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Passwordless sign-in / sign-up: generate at least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STREAMIVIO_AUTH_SECRET=

# Transactional verification emails (Resend). Verify the sender domain in Resend first.
RESEND_API_KEY=
STREAMIVIO_EMAIL_FROM="Streamivio <no-reply@your-verified-domain.example>"
# Public HTTPS origin, e.g. https://your-streamivio-domain.example
# Set both origin values to the same public production origin (no trailing slash).
NEXT_PUBLIC_APP_URL=
APP_URL=

# Streamivio standalone media engine (server-side variables)
STREAMIVIO_API_URL=
STREAMIVIO_METADATA_SEARCH_ENABLED=false
STREAMIVIO_RESOLVER_URL=
