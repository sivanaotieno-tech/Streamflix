# Firebase Web app config (public identifiers; not service-account secrets).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=streamivio.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=streamivio
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=streamivio.firebasestorage.app

# Firebase Admin service account (server-side only; never commit real values).
FIREBASE_PROJECT_ID=streamivio
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Existing payment transaction ledger and provider configuration.
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
INTASEND_WEBHOOK_CHALLENGE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NEXT_PUBLIC_APP_URL=
APP_URL=

# Optional Hyperswitch sandbox adapter.
PAYMENT_PROVIDER=
HYPERSWITCH_ENV=sandbox
HYPERSWITCH_API_KEY=
HYPERSWITCH_WEBHOOK_SECRET=
