# Local PyMovieDb metadata service; see pymoviedb-service/README.md.
PYMOVIEDB_API_URL=http://127.0.0.1:8001

# Streamivio subscriptions (IntaSend hosted checkout supports M-Pesa and cards when enabled on your account).
# Keep secret keys server-side. Never prefix secret keys with NEXT_PUBLIC_.
INTASEND_PUBLISHABLE_KEY=
INTASEND_SECRET_KEY=
# Choose a long random value and enter the same challenge in the IntaSend webhook dashboard.
INTASEND_WEBHOOK_CHALLENGE=
# Durable subscription records: create an Upstash Redis database and copy its REST URL/token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Passwordless sign-in / sign-up: generate at least 32 random characters, e.g.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STREAMIVIO_AUTH_SECRET=

# Transactional verification emails (Resend). Verify the sender domain in Resend first.
RESEND_API_KEY=
STREAMIVIO_EMAIL_FROM="Streamivio <no-reply@your-verified-domain.example>"
# Public HTTPS origin, e.g. https://your-streamivio-domain.example
# Set both origin values to the same public production origin (no trailing slash).
NEXT_PUBLIC_APP_URL=
APP_URL=
